# Create this key at https://aistudio.google.com/api-keys and set it in your shell.
# Never commit the real value.
GEMINI_API_KEY=your-gemini-api-key-here

# Override when another model is enabled in your Gemini account.
GEMINI_MODEL=gemini-3.5-flash-lite

# Accounts are created in the portal; no passwords or login tokens belong here.
FACULTY_MAX_WORKERS=4
RESEARCH_TOOL_BUDGET=10000
